{
  "uid": "darqcube-applications",
  "title": "Applications",
  "tags": [
    "darqcube",
    "flow",
    "applications"
  ],
  "description": "NetFlow traffic by application, from the services modelled in Infrahub (docs/how-to/label-flows-by-application.md).",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Device (exporter)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "darqcube-prometheus"
        },
        "query": "label_values(netflow_flow_bytes_total, device)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "application",
        "label": "Application",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "darqcube-prometheus"
        },
        "query": "label_values(netflow_flow_bytes_total, application)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Applications seen",
      "description": "Modelled applications with flows in the last window.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "darqcube-prometheus"
      },
      "targets": [
        {
          "expr": "count(count by (application) (netflow_flow_bytes_total{device=~\"$device\", application=~\"$application\", application!=\"other\"})) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Unclassified share",
      "description": "Traffic matching no service in Infrahub (application=\"other\"). High means unmodelled servers, or internet traffic.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "darqcube-prometheus"
      },
      "targets": [
        {
          "expr": "sum(netflow_flow_bytes_total{device=~\"$device\", application=~\"$application\", application=\"other\"}) / sum(netflow_flow_bytes_total{device=~\"$device\", application=~\"$application\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Critical application traffic",
      "description": "Throughput to and from applications marked critical in Infrahub.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "darqcube-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (criticality) (avg_over_time(netflow_flow_bytes_total{device=~\"$device\", application=~\"$application\", criticality=\"critical\"}[5m])) * 8 / 60",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Silent critical applications",
      "description": "Critical applications that carried traffic in the last 6 h and none in the last 15 min.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "darqcube-prometheus"
      },
      "targets": [
        {
          "expr": "count(ALERTS{alertname=\"CriticalApplicationSilent\", alertstate=\"firing\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Throughput by application",
      "description": "Every exporter on a flow's path reports it, so summing several devices counts a flow more than once. Pick one device per path (e.g. the branch routers) for totals.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "darqcube-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (application) (avg_over_time(netflow_flow_bytes_total{device=~\"$device\", application=~\"$application\"}[5m])) * 8 / 60",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Throughput by criticality",
      "description": "Every exporter on a flow's path reports it, so summing several devices counts a flow more than once. Pick one device per path (e.g. the branch routers) for totals.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "darqcube-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (criticality) (avg_over_time(netflow_flow_bytes_total{device=~\"$device\", application=~\"$application\"}[5m])) * 8 / 60",
          "legendFormat": "{{criticality}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Throughput by application and protocol",
      "description": "Every exporter on a flow's path reports it, so summing several devices counts a flow more than once. Pick one device per path (e.g. the branch routers) for totals.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "darqcube-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (application, protocol) (avg_over_time(netflow_flow_bytes_total{device=~\"$device\", application=~\"$application\"}[5m])) * 8 / 60",
          "legendFormat": "{{application}} {{protocol}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Volume by application (last hour)",
      "description": "Every exporter on a flow's path reports it, so summing several devices counts a flow more than once. Pick one device per path (e.g. the branch routers) for totals.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "darqcube-prometheus"
      },
      "targets": [
        {
          "expr": "sort_desc(sum by (application) (avg_over_time(netflow_flow_bytes_total{device=~\"$device\", application=~\"$application\"}[1h])) * 60)",
          "legendFormat": "{{application}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Which devices carry each application (last 15 min)",
      "description": "Average throughput per device and application \u2014 where an application's traffic actually flows.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "darqcube-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (device, application, criticality) (avg_over_time(netflow_flow_bytes_total{device=~\"$device\", application=~\"$application\"}[15m])) * 8 / 60",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "throughput"
            }
          }
        }
      ],
      "options": {
        "sortBy": [
          {
            "displayName": "throughput",
            "desc": true
          }
        ]
      }
    }
  ]
}
