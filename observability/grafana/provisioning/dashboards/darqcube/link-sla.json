{
  "uid": "darqcube-link-sla",
  "title": "Link SLA",
  "description": "IP SLA of two groups of links side by side, by probe tag - tag each probe with its interface's description. Availability (success ratio), RTT, jitter per device. Panels 1-3 render as graphs in chat - keep their ids.",
  "tags": [
    "darqcube",
    "snmp",
    "ipsla"
  ],
  "links": [
    {
      "title": "DarqCube dashboards",
      "type": "dashboards",
      "tags": [
        "darqcube"
      ],
      "asDropdown": true
    }
  ],
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "link_a",
        "label": "Link A",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "darqcube-prometheus"
        },
        "query": "label_values(ipsla_sense, probe)",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "sort": 1
      },
      {
        "name": "link_b",
        "label": "Link B",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "darqcube-prometheus"
        },
        "query": "label_values(ipsla_sense, probe)",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "barchart",
      "title": "Availability — $link_a vs $link_b",
      "datasource": {
        "type": "prometheus",
        "uid": "darqcube-prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          },
          "min": 0,
          "max": 100
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "${link_a}"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "${link_b}"
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "device",
        "orientation": "auto",
        "showValue": "always",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "device",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "device",
                "desc": false
              }
            ]
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "avg by (device) (avg_over_time(ipsla:ok{probe=\"$link_a\"}[$__range])) * 100",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "darqcube-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "avg by (device) (avg_over_time(ipsla:ok{probe=\"$link_b\"}[$__range])) * 100",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "darqcube-prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "barchart",
      "title": "Round-trip time — $link_a vs $link_b",
      "datasource": {
        "type": "prometheus",
        "uid": "darqcube-prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "${link_a}"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "${link_b}"
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "device",
        "orientation": "auto",
        "showValue": "always",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "device",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "device",
                "desc": false
              }
            ]
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "avg by (device) (avg_over_time((ipsla_rtt_ms{probe=\"$link_a\"} and on (device, index) ipsla_sense == 1)[$__range:1m]))",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "darqcube-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "avg by (device) (avg_over_time((ipsla_rtt_ms{probe=\"$link_b\"} and on (device, index) ipsla_sense == 1)[$__range:1m]))",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "darqcube-prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "barchart",
      "title": "Jitter — $link_a vs $link_b",
      "datasource": {
        "type": "prometheus",
        "uid": "darqcube-prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "${link_a}"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "${link_b}"
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "device",
        "orientation": "auto",
        "showValue": "always",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "device",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "device",
                "desc": false
              }
            ]
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "avg by (device) (stddev_over_time(ipsla_rtt_ms{probe=\"$link_a\", rtt_type=\"1\"}[$__range]))",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "darqcube-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "avg by (device) (stddev_over_time(ipsla_rtt_ms{probe=\"$link_b\", rtt_type=\"1\"}[$__range]))",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "darqcube-prometheus"
          }
        }
      ]
    }
  ]
}
