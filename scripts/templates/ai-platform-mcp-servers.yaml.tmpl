# The stack's seven MCP servers, for the ai-platform's MCP server configuration.
# Generated by scripts/ai-platform-connect.py. Each server checks the caller's
# own token (forwarded by the ai-platform in the header below), so a call is
# attributable to a person and the write role is enforced per person.
mcp_servers:
# --- per server ---
  - id: "darqcube-{name}"
    name: "DARQCUBE {name}"
    description: "{description}"
    transport: "http"
    endpoint: "http://{stack_host}:{port}/mcp"
    enabled: true
    credential_sources:
      - kind: "caller_token"
        name: "{token_header}"
        target: "header"
        fallback_client_credentials: true
