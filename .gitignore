# Secrets — never commit
.env

# Generated by source-of-truth/scripts/render-inventory.py on every `make render`.
# Anything you put here is lost. Edit platforms.yml or Infrahub instead.
observability/telegraf/generated/*
!observability/telegraf/generated/.gitkeep

# Device configs retrieved by the automation layer
automation/configs/*
!automation/configs/.gitkeep

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Editors / OS
.DS_Store
.idea/
*.swp

# Site file — contains credentials. Never commit.
site.yml
sites/*.yml
!sites/example.yml
