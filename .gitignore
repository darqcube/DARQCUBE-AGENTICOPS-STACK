# Secrets — never commit
.env

# Generated by source-of-truth/scripts/render-inventory.py on every `make render`.
# Anything you put here is lost. Edit platforms.yml or Infrahub instead.
observability/telegraf/generated/*
!observability/telegraf/generated/.gitkeep

# Network Map: the per-deployment drawing, and the dashboard `make render` builds from it
source-of-truth/map/*.yml
observability/grafana/provisioning/dashboards/generated/*
!observability/grafana/provisioning/dashboards/generated/.gitkeep

# Device configs retrieved by the automation layer
automation/configs/*
!automation/configs/.gitkeep

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Editors / OS
.DS_Store
.idea/
*.swp

# Local compose override — lab networks and addresses. See
# docs/how-to/run-on-a-docker-engine.md.
compose.override.yaml
compose.override.yml

# Site file — contains credentials. Never commit.
site.yml
sites/*.yml
!sites/example.yml

/net-commander

# Your inventory — per deployment, like site.yml. Only the examples are tracked;
# `make seed` reads source-of-truth/devices/*.yml and never the examples/ folder.
source-of-truth/devices/*.yml
source-of-truth/devices/*.yaml
# Written by scripts/ai-platform-connect.py — they name this deployment's addresses
ai-platform.site.yml
mcp-servers.snippet.yaml
