# ---------------------------------------------------------------------------
# DARQCUBE-AGENTICOPS-STACK configuration
#
#   cp .env.example .env    then fill in every CHANGEME below.
#   scripts/gen-secrets.sh does this for you and generates random secrets.
#
# `make preflight` refuses to start while any CHANGEME remains.
# ---------------------------------------------------------------------------

# --- Which container groups to start -------------------------------------
# devices    = Telegraf SNMP/gNMI/NetFlow collection (needs devices in Infrahub)
# automation = Nornir / Netmiko / TextFSM / pyATS API
# mcp        = the seven MCP servers (optional — the stack is fully usable without them)
# graphs     = Grafana's image renderer, for graphs in an ai-platform's chat (optional)
COMPOSE_PROFILES=devices,automation,mcp


# =========================================================================
# 1. THINGS YOU MUST SET
# =========================================================================

# --- Device access (one pair, used by Nornir, Netmiko and pyATS alike) ----
DEVICE_USER=CHANGEME
DEVICE_PASSWORD=CHANGEME

# --- SNMPv3 (must match what you configured on the devices) --------------
SNMPV3_USER=darqcube
SNMPV3_AUTH=CHANGEME
SNMPV3_PRIV=CHANGEME

# --- Where devices send syslog and flow ----------------------------------
# THE VM'S OWN ROUTABLE IP — not a container IP, not 127.0.0.1. This is the
# address you put in each device's logging/traffic-flow config, and devices
# must be able to reach it. Find it with:  ip -4 addr show scope global
SYSLOG_COLLECTOR_IP=CHANGEME

# --- Grafana -------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGEME

# --- Infrahub ------------------------------------------------------------
NEO4J_PASSWORD=CHANGEME
RABBITMQ_USER=infrahub
RABBITMQ_PASSWORD=CHANGEME
POSTGRES_PASSWORD=CHANGEME
INFRAHUB_SECRET_KEY=CHANGEME
INFRAHUB_ADMIN_TOKEN=CHANGEME

# --- MCP -----------------------------------------------------------------
MCP_AUTH_TOKEN=CHANGEME
# Signs Infrahub -> render-hook webhooks (auto-render, optional).
RENDER_HOOK_SECRET=CHANGEME

# Lets an AI platform PUSH CONFIGURATION to devices through mcp-netmiko.
# Default false: push_device_config is not registered at all, so it cannot be
# called. Set true only when you intend an AI to make changes.
#
# NOTE: this gates the MCP TOOL, not the automation API beneath it. The API has
# no authentication, so anything that can reach AUTOMATION_PORT can push config
# whatever this says. Unpublish that port to close the bypass — the MCP servers
# reach the API over the Docker network, so the AI path is unaffected.
# docs/how-to/connect-an-ai-platform.md
MCP_ALLOW_WRITE=false

# --- MCP for an ai-platform on ANOTHER machine (optional) ---------------
# All of these differ per deployment, and install.py writes them from site.yml
# (ai_platform:) or from sites/ai-platform.yml — generated on the ai-platform
# host by scripts/ai-platform-connect.py. Use YOUR addresses, never an example's.
#
# Address the MCP ports (9001-9007) are published on. 127.0.0.1 = this host
# only. For another machine: this host's IP on a network it can route to.
MCP_BIND_IP=127.0.0.1
# Host headers accepted besides loopback and the compose names: "<ip>:*".
# A request naming any other Host is refused with 421.
MCP_ALLOWED_HOSTS=
# token (shared MCP_AUTH_TOKEN) | oidc (caller's own JWT) | both
MCP_AUTH_MODE=token
# oidc/both: the "iss" claim, the JWKS URL reachable from THIS host, and the
# accepted "aud" values (comma-separated; empty = not checked).
MCP_OIDC_ISSUER=
MCP_OIDC_JWKS_URL=
MCP_OIDC_AUDIENCES=
# Role an oidc caller needs for push_device_config.
MCP_WRITE_ROLE=darqcube-write
# Cap on one tool result in bytes. Lower for small local models.
MCP_MAX_RESPONSE_BYTES=524288
# How a person reaches Grafana — for links mcp-grafana returns.
# e.g. http://<this-host>:13000
GRAFANA_PUBLIC_URL=
# Graphs in chat (site.yml ai_platform.graphs; install.py sets all three):
# registers render_interface_graph, points Grafana at its renderer (add
# "graphs" to COMPOSE_PROFILES), and the URL a BROWSER opens images on —
# http://<this-host>:9004, or an HTTPS reverse proxy in front of it.
MCP_GRAPHS_ENABLED=false
GRAFANA_RENDERER_URL=
MCP_IMAGE_BASE_URL=
# How long an image link works, and the time zone graphs are drawn in.
MCP_IMAGE_TTL_SECONDS=900
MCP_GRAPH_TZ=UTC

# Auto-render (optional): add "auto-render" to COMPOSE_PROFILES (site.yml:
# source_of_truth.auto_render: true), then `make auto-render` once.
# Seconds to wait after the last Infrahub change before rendering.
RENDER_HOOK_DEBOUNCE=15


# =========================================================================
# 2. PUBLISHED PORTS
# =========================================================================
#
# Only the HOST side is configurable. Inside the Docker network every service
# still listens on its standard port, so changing these never affects
# service-to-service URLs — Grafana always reaches Prometheus at
# http://prometheus:9090 regardless of what you set here.
#
# TO REVERT TO STANDARD PORTS: set each variable to the "standard" value
# shown in its comment, or just delete this whole section — the compose files
# fall back to the standard port when a variable is unset.
#
# Shipped non-standard by default so the stack can run alongside something
# else already using the usual ports. Check with:  ./scripts/preflight.sh

# --- Web UIs and APIs ----------------------------------------------------
GRAFANA_PORT=13000                # standard: 3000
INFRAHUB_PORT=18000               # standard: 8000
PROMETHEUS_PORT=19090             # standard: 9090
ALERTMANAGER_PORT=19093           # standard: 9093
LOKI_PORT=13100                   # standard: 3100
AUTOMATION_PORT=18100             # standard: 8100

# --- Device-facing listeners ---------------------------------------------
# CHANGING THESE MEANS CHANGING EVERY DEVICE. They are the ports your switches
# and routers send to, so a change here must be matched in each device's
# logging / traffic-flow configuration (docs/devices/*.md).
# Port 514 also needs root on most Linux hosts; 1514 avoids that.
SYSLOG_PORT=1514                  # standard: 514
NETFLOW_PORT=12055                # standard: 2055
IPFIX_PORT=14739                  # standard: 4739
# Dedicated NetFlow listeners, one per device with flow_port set in Infrahub,
# for exporters whose source address is NAT'd. See docs/how-to/flow-behind-nat.md.
FLOW_DEDICATED_FIRST=12056        # standard: 2056
FLOW_DEDICATED_LAST=12105         # standard: 2105


# =========================================================================
# 3. OPTIONAL
# =========================================================================

# gNMI (Cisco only in this stack; leave blank if unused)
GNMI_USER=
GNMI_PASSWORD=

# Where Alertmanager sends alerts. Blank = a null receiver, so the stack
# starts with no external dependency. Point this at your AI platform later.
ALERT_WEBHOOK_URL=

# Cap on lines accepted by a single config push
MAX_CONFIG_LINES=200


# =========================================================================
# 4. SCALE — the stack is sized and tested up to 400 devices
# =========================================================================
#
#   400 devices x ~30 interfaces  ~=  105,000 active Prometheus series
#                                     ~1,700 samples/sec at 60s polling
#                                     ~4 GB of metrics per 15 days
#
# Defaults below are the 400-device settings. For a lab of a dozen devices you
# can safely drop SNMP_INTERVAL to 30s for a livelier demo.

# How often devices are polled. 60s is the fleet setting; 30s is fine for a
# lab. It must stay SHORTER than Prometheus's scrape_interval or samples are
# missed, and long enough that a slow device does not overrun the cycle —
# SNMP_TIMEOUT x (SNMP_RETRIES + 1) is 20s.
SNMP_INTERVAL=60s

# Per SNMP request: how long to wait, and how many times to retry. SNMP is
# UDP, so retries are what absorb ordinary packet loss on the path. An
# unreachable device costs SNMP_TIMEOUT x (SNMP_RETRIES + 1) of its shard's
# poll window — keep it at or under 20s (docs/scale.md). Raise SNMP_TIMEOUT,
# not retries, for slow links or CPU-busy devices.
SNMP_TIMEOUT=5s
SNMP_RETRIES=3

# Scheduled assurance (optional): run automation/assurance/rules.yml on every
# device every N minutes and expose the results to Prometheus. 0 = off. Each
# run opens SSH (and pyATS, where declared) sessions to every device,
# AUTOMATION_CONCURRENCY at a time — allow roughly devices x 20 s / that
# concurrency per run, and keep the interval longer than that.
ASSURANCE_INTERVAL_MINUTES=0

# Devices per [[inputs.snmp]] instance. Each shard is its own gather loop, so
# one unreachable device cannot eat the whole fleet's poll window, and a
# Telegraf error names which group is slow. 150 x 30 interfaces walks
# comfortably inside 60s.
SNMP_SHARD_SIZE=150

# Devices the automation layer talks to at once. Raise for faster fleet-wide
# runs; each one is an SSH session, so this is bounded by the host and by what
# your devices tolerate.
AUTOMATION_CONCURRENCY=16


# =========================================================================
# 5. TUNING — sensible defaults, change only if you need to
# =========================================================================

DEPLOYMENT_NAME=darqcube
PROM_RETENTION=15d
LOKI_RETENTION=336h
INFRAHUB_BRANCH=main

# --- Image versions ------------------------------------------------------
INFRAHUB_VERSION=1.10.9
NEO4J_VERSION=2025.10.1-community
REDIS_VERSION=8.4
RABBITMQ_VERSION=4.2.1-management
POSTGRES_VERSION=18-alpine
TELEGRAF_VERSION=1.34
LOGSTASH_VERSION=8.15.3
PROMETHEUS_VERSION=v3.4.1
ALERTMANAGER_VERSION=v0.28.1
LOKI_VERSION=3.5.1
GRAFANA_VERSION=12.0.2
# Grafana plugins installed at start (id@version, comma-separated). The
# Network Map dashboard needs tamirsuliman-weathermap-panel.
GRAFANA_PLUGINS=tamirsuliman-weathermap-panel@1.6.16
